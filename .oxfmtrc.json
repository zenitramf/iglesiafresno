{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {},
  "sortTailwindcss": {},
  "ignorePatterns": [
    "dist/**",
    ".astro/**",
    "node_modules/**",
    "public/**",
    "pnpm-lock.yaml",
    "**/*.astro"
  ]
}
