{
  "name": "iglesiafresno",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --ignore-path .gitignore && prettier --write \"**/*.astro\"",
    "format:check": "oxfmt --check --ignore-path .gitignore && prettier --check \"**/*.astro\"",
    "check": "oxlint && oxfmt --check --ignore-path .gitignore && prettier --check \"**/*.astro\"",
    "fix": "oxlint --fix && oxfmt --ignore-path .gitignore && prettier --write \"**/*.astro\"",
    "test:e2e": "playwright test",
    "test:e2e:vision": "playwright test tests/vision-bento.spec.ts",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tabler/icons": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
