---
import BaseHead from "@/components/layout/base-head.astro";
import SiteFooter from "@/components/layout/site-footer.astro";
import SiteHeader from "@/components/layout/site-header.astro";
import heroImage from "@/images/iglesiaFresnoHeroImage.webp";
import {
  getCriticalImagePreload,
  HERO_IMAGE_QUALITY,
  HERO_IMAGE_SIZES,
  HERO_IMAGE_WIDTHS,
} from "@/lib/critical-images";
import type { CriticalPreload } from "@/lib/critical-images";
import type { SEOInput } from "@/lib/seo";
import { buildSEO } from "@/lib/seo";
import "@/styles/starwind.css";

interface Props extends SEOInput {
  /** Extra `<link rel="preload">` images. */
  extraCriticalPreloads?: CriticalPreload[];
  /** Whether to preload the shared hero background image. Defaults to `true`. */
  preloadHero?: boolean;
}

const {
    extraCriticalPreloads = [],
    preloadHero = true,
    ...seoInput
  }: Props = Astro.props,
  seo = buildSEO(seoInput),
  criticalPreloads = [
    ...(preloadHero
      ? [
          await getCriticalImagePreload(
            heroImage,
            HERO_IMAGE_WIDTHS,
            HERO_IMAGE_SIZES,
            HERO_IMAGE_QUALITY,
          ),
        ]
      : []),
    ...extraCriticalPreloads,
  ];
---

<!doctype html>
<html class="dark" lang="es">
  <head>
    <BaseHead {...seo} currentUrl={Astro.url} />
    {
      criticalPreloads.map((image) => (
        <link
          as="image"
          fetchpriority="high"
          href={image.src}
          imagesizes={image.sizes}
          imagesrcset={image.srcSet}
          rel="preload"
        />
      ))
    }
  </head>
  <body class="min-h-svh bg-background font-sans text-foreground antialiased">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
      href="#contenido-principal"
    >
      Saltar al contenido principal
    </a>
    <SiteHeader />
    <main id="contenido-principal">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import {
        resolveCtaPlacement,
        resolveCtaTargetFromHref,
        sanitizeAnalyticsPath,
      } from "@/lib/analytics-dimensions";

      const handlePointerActivation = (event: MouseEvent): void => {
        if (event.defaultPrevented || !(event.target instanceof Element)) {
          return;
        }
        const isPrimaryClick = event.type === "click" && event.button === 0;
        const isMiddleClick = event.type === "auxclick" && event.button === 1;
        if (!isPrimaryClick && !isMiddleClick) {
          return;
        }
        const anchor = event.target.closest("a[href]");
        if (!anchor) {
          return;
        }
        const target = resolveCtaTargetFromHref(anchor.getAttribute("href"));
        if (!target) {
          return;
        }
        const payload = JSON.stringify({
          path: sanitizeAnalyticsPath(window.location.pathname),
          placement: resolveCtaPlacement(anchor),
          target,
        });
        try {
          if (navigator.sendBeacon) {
            navigator.sendBeacon("/api/evento", payload);
            return;
          }
          fetch("/api/evento", {
            body: payload,
            headers: { "Content-Type": "text/plain;charset=UTF-8" },
            keepalive: true,
            method: "POST",
          }).catch(() => undefined);
        } catch {
          // Never block navigation if beacon dispatch fails.
        }
      };

      document.addEventListener("click", handlePointerActivation);
      document.addEventListener("auxclick", handlePointerActivation);
    </script>
  </body>
</html>
