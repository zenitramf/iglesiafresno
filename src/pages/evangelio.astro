---
import Assurance from "@/components/evangelio/assurance.astro";
import Hero from "@/components/evangelio/hero.astro";
import Invitation from "@/components/evangelio/invitation.astro";
import Prayer from "@/components/evangelio/prayer.astro";
import Steps from "@/components/evangelio/steps.astro";
import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout
  description="¿Cómo puedo ir al cielo? Lee el mensaje bíblico de la salvación en cuatro pasos y descubre cómo tener vida eterna por medio de Jesucristo."
  title="Evangelio | Iglesia Bautista Victory"
>
  <Hero />
  <Steps />
  <Prayer />
  <Assurance />
  <Invitation />
</BaseLayout>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
</style>
