---
import PageHero from "@/components/layout/page-hero.astro";
import SiteContainer from "@/components/layout/site-container.astro";
import { Button } from "@/components/starwind/button";
import andrewMunizPhoto from "@/images/andrew_profile.webp";
import franciscoMartinezPhoto from "@/images/fmartinez_profile.webp";
import pastorWillisPhoto from "@/images/rwillis_profile.webp";
import BaseLayout from "@/layouts/base-layout.astro";
import { churchInfo } from "@/lib/church-data";

const pastorWillisBio = [
  "El pastor Willis comenzó a servir en Victory Baptist Church mientras aún estudiaba en la universidad, en 2011. Al graduarse en 2012, se mudó a Fresno y sirvió como pastor asistente.",
  "Durante ese tiempo ha participado en varios ministerios de la iglesia, entre ellos el de niños, jóvenes, alcance, discipulado, predicación, enseñanza y consejería.",
  "En 2021 el pastor Willis se convirtió en el pastor principal de Victory Baptist Church. Sirve junto a su esposa Kali y sus cinco hijos. Llevan casados ocho años.",
  "El pastor Willis está comprometido a servir fiel y bíblicamente a Victory Baptist Church y a la comunidad de Fresno.",
] as const;

const franciscoMartinezBio = [
  "Francisco Martinez se unió a la Iglesia Bautista Victory en 2015. Desde entonces, él y su esposa, Vanessa, han servido fielmente en varios ministerios, entre ellos el Ministerio de Niños Kings Kids, el ministerio de música y el ministerio en español.",
  "En 2026, Dios llamó a Francisco a predicar Su Palabra a la comunidad hispana de Fresno, California. Francisco sirve como el líder del Ministerio en Español de la Iglesia Bautista Victory.",
] as const;

const andrewMunizBio = [
  "Andrew Muniz llegó a Cristo en 2021 en el campamento de adolescentes y, poco después, consagró su vida al ministerio vocacional. Actualmente es interno en Victory Baptist Church, sirviendo en el ministerio en español y en el evangelismo.",
  "Mediante el alcance los sábados y la traducción al español, Andrew ayuda a los vecinos de habla hispana a oír el evangelio y a conectarse con la vida de la iglesia en Fresno.",
] as const;
---

<BaseLayout
  description="Conoce al pastor Ryan Willis, a Francisco Martinez, a Andrew Muniz y a los líderes ministeriales de Iglesia Bautista Victory en Fresno."
  title="Equipo | Iglesia Bautista Victory"
>
  <PageHero
    description="Conoce a nuestro pastor y a los líderes ministeriales que sirven en Iglesia Bautista Victory y en Fresno con humildad y amor."
    eyebrow="Liderazgo"
    title="Conoce al equipo"
  />

  <section class="site-gutter border-t border-border py-16 sm:py-20">
    <SiteContainer class="flex flex-col gap-16">
      <article>
        <div class="mb-8 flex items-center gap-5">
          <div
            class="relative size-24 shrink-0 overflow-hidden rounded-xl border-[3px] border-primary md:size-28"
          >
            <img
              alt="Pastor Ryan Willis"
              class="absolute top-1/2 left-1/2 h-[120%] w-[120%] max-w-none -translate-x-[50%] -translate-y-[54%] object-cover"
              decoding="async"
              height="112"
              loading="eager"
              src={pastorWillisPhoto.src}
              width="112"
            />
          </div>
          <div>
            <p
              class="mb-1 font-semibold text-primary text-sm tracking-widest uppercase"
            >
              Pastor principal
            </p>
            <h2
              class="font-semibold text-3xl text-foreground tracking-tight md:text-4xl"
            >
              Ryan Willis
            </h2>
          </div>
        </div>
        <div class="space-y-5 text-lg text-muted-foreground leading-relaxed">
          {pastorWillisBio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>

      <article>
        <div class="mb-8 flex items-center gap-5">
          <img
            alt="Francisco Martinez"
            class="size-24 shrink-0 rounded-xl border-[3px] border-primary object-cover object-top md:size-28"
            decoding="async"
            height="112"
            loading="eager"
            src={franciscoMartinezPhoto.src}
            width="112"
          />
          <div>
            <p
              class="mb-1 font-semibold text-primary text-sm tracking-widest uppercase"
            >
              Líder del Ministerio en Español
            </p>
            <h2
              class="font-semibold text-3xl text-foreground tracking-tight md:text-4xl"
            >
              Francisco Martinez
            </h2>
          </div>
        </div>
        <div class="space-y-5 text-lg text-muted-foreground leading-relaxed">
          {franciscoMartinezBio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>

      <article>
        <div class="mb-8 flex items-center gap-5">
          <img
            alt="Andrew Muniz"
            class="size-24 shrink-0 rounded-xl border-[3px] border-primary object-cover object-top md:size-28"
            decoding="async"
            height="112"
            loading="eager"
            src={andrewMunizPhoto.src}
            width="112"
          />
          <div>
            <p
              class="mb-1 font-semibold text-primary text-sm tracking-widest uppercase"
            >
              Ministerio en español / Evangelismo
            </p>
            <h2
              class="font-semibold text-3xl text-foreground tracking-tight md:text-4xl"
            >
              Andrew Muniz
            </h2>
          </div>
        </div>
        <div class="space-y-5 text-lg text-muted-foreground leading-relaxed">
          {andrewMunizBio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>

      <div class="flex flex-wrap gap-3 border-t border-border pt-10">
        <Button href={`mailto:${churchInfo.email}`} size="lg" variant="primary">
          Contáctanos
        </Button>
        <Button href="/visita" size="lg" variant="secondary">
          Planifica tu visita
        </Button>
      </div>
    </SiteContainer>
  </section>
</BaseLayout>
