---
import PageHero from "@/components/layout/page-hero.astro";
import SiteContainer from "@/components/layout/site-container.astro";
import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout
  description="Revise los términos que rigen el uso del sitio web de Iglesia Bautista Victory y de su contenido."
  title="Términos de uso | Iglesia Bautista Victory"
>
  <PageHero
    description="Condiciones que rigen el uso de este sitio y de su contenido."
    eyebrow="Legal"
    title="Términos de uso"
  />

  <section class="site-gutter py-16 sm:py-20">
    <SiteContainer>
      <div class="max-w-2xl">
        <p class="text-base text-muted-foreground leading-relaxed">
          El contenido de este sitio web es proporcionado por Iglesia Bautista
          Victory con fines informativos y de ministerio. Los medios de mensajes
          y los materiales escritos son propiedad de la iglesia, salvo que se
          indique lo contrario. Por favor, contáctenos antes de republicar
          cualquier contenido.
        </p>
      </div>
    </SiteContainer>
  </section>
</BaseLayout>
