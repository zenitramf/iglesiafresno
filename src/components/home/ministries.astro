---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import Check from "@tabler/icons/outline/check.svg";
import Friends from "@tabler/icons/outline/friends.svg";
import Man from "@tabler/icons/outline/man.svg";
import MoodKid from "@tabler/icons/outline/mood-kid.svg";
import School from "@tabler/icons/outline/school.svg";
import Walk from "@tabler/icons/outline/walk.svg";
import Woman from "@tabler/icons/outline/woman.svg";
import { Button } from "@/components/starwind/button";

const featuredHighlights = [
  "Evangelismo de puerta en puerta",
  "Eventos comunitarios",
  "Apoyo misionero",
  "Capacitación para compartir el evangelio",
] as const;

const ministries = [
  {
    description:
      "Enseñanza bíblica sólida en un ambiente seguro para bebés hasta sexto grado los domingos, más un programa infantil los jueves.",
    href: "#visita",
    icon: MoodKid,
    title: "Niños",
  },
  {
    description:
      "Un lugar espiritualmente sano para que los jóvenes construyan amistades, hagan preguntas difíciles y crezcan en la fe.",
    href: "#visita",
    icon: School,
    title: "Adolescentes",
  },
  {
    description:
      "Reuniones para egresados de secundaria y universitarios que desean fortalecer su fe y cultivar amistades piadosas.",
    href: "#visita",
    icon: Friends,
    title: "Jóvenes adultos",
  },
  {
    description:
      "Actividades que animan a los hombres a crecer en devoción personal a Dios y en liderazgo espiritual en el hogar.",
    href: "#visita",
    icon: Man,
    title: "Hombres",
  },
  {
    description:
      "Estudios bíblicos y comunión que refrescan y animan a las mujeres a crecer en fe y amistad mediante la oración.",
    href: "#visita",
    icon: Woman,
    title: "Mujeres",
  },
  {
    description:
      "Estudio bíblico y oración para adultos mayores, cultivando compañerismo y esperanza en esta etapa de la vida.",
    href: "#visita",
    icon: Walk,
    title: "Adultos mayores",
  },
] as const;

/** Unsplash: neighborhood front doors — temporary placeholder for evangelism featured image */
const featuredImageSrc =
  "https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=1200&q=80";
---

<section
  class="@container scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 md:px-10 lg:px-14"
  id="ministerios"
>
  <div class="mx-auto w-full max-w-7xl">
    <div class="mb-12 max-w-xl">
      <p
        class="mb-3 text-sm font-medium tracking-[0.18em] text-primary-accent uppercase"
      >
        Ministerios
      </p>
      <h2
        class="font-heading text-3xl font-semibold tracking-tight @xl:text-4xl @3xl:text-5xl"
      >
        El alcance es nuestro corazón.
      </h2>
      <p class="mt-4 text-pretty text-muted-foreground @xl:text-lg">
        Cada ministerio de Iglesia Fresno sirve a una sola misión: alcanzar
        Fresno — y el mundo — con el evangelio de Jesucristo.
      </p>
    </div>

    <div class="grid gap-6 @2xl:grid-cols-2 @4xl:grid-cols-3">
      <!-- Featured: Evangelismo -->
      <div
        class="group relative overflow-hidden rounded-2xl bg-muted @2xl:col-span-2 @4xl:row-span-2"
        id="evangelismo"
      >
        <div class="grid h-full @xl:grid-cols-2">
          <div
            class="relative aspect-square w-full @xl:aspect-auto @xl:min-h-full"
          >
            <img
              alt="Puertas de casas en un vecindario residencial"
              class="absolute inset-0 size-full object-cover"
              decoding="async"
              height="600"
              loading="lazy"
              src={featuredImageSrc}
              width="600"
            >
          </div>

          <div class="flex flex-col justify-center p-6 @xl:p-8">
            <span
              class="mb-2 text-sm font-medium tracking-wider text-primary-accent uppercase"
            >
              Destacado
            </span>
            <h3 class="font-heading text-2xl font-semibold @xl:text-3xl">
              Evangelismo
            </h3>
            <p class="mt-3 text-pretty text-muted-foreground">
              Una de nuestras mayores responsabilidades es alcanzar a otros con
              el evangelio de Jesucristo. No necesitas experiencia: solo un
              corazón dispuesto. Te emparejaremos con alguien y te mostraremos
              cómo hacerlo.
            </p>

            <ul class="mt-6 flex flex-col gap-2">
              {featuredHighlights.map((item) => (
                                    <li class="flex items-center gap-2 text-sm">
                                        <Check
                                            aria-hidden="true"
                                            class="size-4 shrink-0 text-primary-accent"
                                        />
                                        <span>{item}</span>
                                    </li>
                                ))}
            </ul>

            <div class="mt-6">
              <Button
                class="group/btn"
                href="/cielo"
                size="md"
                variant="primary"
              >
                Camino a la salvación
                <ArrowRight
                  aria-hidden="true"
                  class="size-4 transition-transform group-hover/btn:translate-x-1"
                />
              </Button>
            </div>
          </div>
        </div>
      </div>

      <!-- Ministry cards -->
      {ministries.map((ministry) => {
                    const Icon = ministry.icon;

                    return (
                        <div class="group rounded-2xl border bg-card @xl:p-8 p-6 transition-colors hover:border-primary-accent/50">
                            <div class="mb-4 inline-flex size-12 items-center justify-center rounded-xl bg-primary-accent/10 text-primary-accent transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
                                <Icon aria-hidden="true" class="size-6" />
                            </div>
                            <h3 class="font-heading font-semibold text-lg">
                                {ministry.title}
                            </h3>
                            <p class="mt-2 text-pretty text-muted-foreground text-sm">
                                {ministry.description}
                            </p>
                            <a
                                class="mt-4 inline-flex items-center gap-1 font-medium text-primary-accent text-sm transition-colors hover:underline"
                                href={ministry.href}
                            >
                                Saber más
                                <ArrowRight
                                    aria-hidden="true"
                                    class="size-4 transition-transform group-hover:translate-x-1"
                                />
                            </a>
                        </div>
                    );
                })}
    </div>
  </div>
</section>
