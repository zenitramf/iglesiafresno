---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import Bible from "@tabler/icons/outline/bible.svg";
import Check from "@tabler/icons/outline/check.svg";
import Cross from "@tabler/icons/outline/cross.svg";
import Home from "@tabler/icons/outline/home.svg";
import UserHeart from "@tabler/icons/outline/user-heart.svg";
import World from "@tabler/icons/outline/world.svg";
import SiteContainer from "@/components/layout/site-container.astro";
import { Button } from "@/components/starwind/button";

const featuredHighlights = [
  "Evangelismo de puerta en puerta",
  "Eventos comunitarios",
  "Apoyo misionero",
  "Capacitación para compartir el evangelio",
] as const;

/**
 * Vision pillars (excluding Evangelismo Personal — that is the featured bento).
 * Five cards + featured 2×2 cell fill a 3×3 at @4xl with no orphan.
 */
const visionPillars = [
  {
    description:
      "Exposición fiel de las Escrituras, enseñando precepto por precepto.",
    icon: Bible,
    title: "Predicación y Enseñanza Bíblica",
  },
  {
    description:
      "Equipar a los nuevos creyentes para que crezcan en su fe y sirvan dentro de la iglesia local.",
    icon: UserHeart,
    title: "Discipulado Personal",
  },
  {
    description:
      "Enseñar y ministrar a cada miembro del hogar, fortaleciendo las familias cristianas.",
    icon: Home,
    title: "Ministerio Familiar",
  },
  {
    description:
      "Apoyar y enviar misioneros, así como plantar iglesias en otras comunidades y en el extranjero.",
    icon: World,
    title: "Mentalidad Misionera",
  },
  {
    description:
      "Vivir una vida cristiana apartada de la cultura secular, conforme a la imagen de Cristo.",
    icon: Cross,
    title: "Santificación Personal",
  },
] as const;

/** Unsplash: neighborhood front doors — temporary placeholder for evangelism featured image */
const featuredImageSrc =
  "https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=1200&q=80";
---

<section
  class="site-gutter @container scroll-mt-8 py-16 sm:py-20"
  data-vision-bento
  id="vision"
>
  <SiteContainer>
    <div class="mb-12 max-w-xl">
      <p
        class="mb-3 text-sm font-medium tracking-[0.18em] text-primary-accent uppercase"
      >
        Visión
      </p>
      <h2
        class="font-heading text-3xl font-semibold tracking-tight @xl:text-4xl @3xl:text-5xl"
      >
        Lo que nos guía.
      </h2>
      <p class="mt-4 text-pretty text-muted-foreground @xl:text-lg">
        Estos pilares orientan la vida y el alcance de Iglesia Bautista Victory:
        predicar la Escritura, evangelizar, discipular, fortalecer familias,
        enviar misioneros y vivir apartados para Cristo.
      </p>
    </div>

    <!--
      Bento: featured Evangelismo Personal (2×2 at @4xl) + 5 vision cards.
      At 3 columns the 2×2 + 5 cells fill a 3×3 with no orphan.
      At 2 columns featured is full-width; five cards use an even fill via
      the last card spanning when alone would look stray — see last-card class.
    -->
    <div
      class="grid grid-cols-1 gap-6 @2xl:grid-cols-2 @4xl:grid-cols-3"
      data-vision-grid
    >
      <!-- Featured: Evangelismo Personal -->
      <div
        class="group relative overflow-hidden rounded-2xl bg-muted @2xl:col-span-2 @4xl:row-span-2"
        data-featured-evangelism
        id="evangelismo"
      >
        <div class="grid h-full @xl:grid-cols-2">
          <div
            class="relative aspect-square w-full @xl:aspect-auto @xl:min-h-full"
          >
            <img
              alt="Puertas de casas en un vecindario residencial"
              class="absolute inset-0 size-full object-cover"
              decoding="async"
              height="600"
              loading="lazy"
              src={featuredImageSrc}
              width="600"
            >
          </div>

          <div class="flex flex-col justify-center p-6 @xl:p-8">
            <span
              class="mb-2 text-sm font-medium tracking-wider text-primary-accent uppercase"
            >
              Destacado
            </span>
            <h3 class="font-heading text-2xl font-semibold @xl:text-3xl">
              Evangelismo Personal
            </h3>
            <p class="mt-3 text-pretty text-muted-foreground">
              Alcanzar a nuestra comunidad con el mensaje del evangelio mediante
              visitas regulares y ministerios de alcance.
            </p>

            <ul class="mt-6 flex flex-col gap-2">
              {featuredHighlights.map((item) => (
                <li class="flex items-center gap-2 text-sm">
                  <Check
                    aria-hidden="true"
                    class="size-4 shrink-0 text-primary-accent"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-6">
              <Button
                class="group/btn"
                href="/evangelio"
                size="md"
                variant="primary"
              >
                Camino a la salvación
                <ArrowRight
                  aria-hidden="true"
                  class="size-4 transition-transform group-hover/btn:translate-x-1"
                />
              </Button>
            </div>
          </div>
        </div>
      </div>

      <!-- Vision pillar cards (Evangelismo Personal is only in the featured cell) -->
      {visionPillars.map((pillar, index) => {
        const Icon = pillar.icon;
        const isLast = index === visionPillars.length - 1;

        return (
          <div
            data-vision-card
            class:list={[
              "group rounded-2xl border bg-card @xl:p-8 p-6 transition-colors hover:border-primary-accent/50",
              // At 2 cols, 5 cards leave one alone — span full width so it is not a stray half-row box.
              // At 3 cols the classic 2×2 featured + 5 fills a 3×3; reset span.
              isLast && "@2xl:col-span-2 @4xl:col-span-1",
            ]}
          >
            <div class="mb-4 inline-flex size-12 items-center justify-center rounded-xl bg-primary-accent/10 text-primary-accent transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
              <Icon aria-hidden="true" class="size-6" />
            </div>
            <h3 class="font-heading font-semibold text-lg">{pillar.title}</h3>
            <p class="mt-2 text-pretty text-muted-foreground text-sm">
              {pillar.description}
            </p>
          </div>
        );
      })}
    </div>
  </SiteContainer>
</section>
