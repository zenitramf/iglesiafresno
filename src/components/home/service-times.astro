---
const times = [
  { label: "Escuela Dominical", time: "10:00 a. m." },
  { label: "Culto de la mañana", time: "11:00 a. m." },
  { label: "Culto de la tarde", time: "6:00 p. m." },
  { label: "Estudio bíblico (jueves)", time: "7:00 p. m." },
] as const;
---

<section
  aria-label="Horarios de servicio"
  class="border-y border-border bg-card px-4 py-8 sm:px-6 md:px-10 lg:px-14"
>
  <div class="mx-auto grid max-w-7xl gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {times.map((item) => (
        <div class="grid gap-1 rounded-lg border border-border/70 bg-background/40 px-4 py-4">
          <p class="font-medium text-primary-accent text-xs uppercase tracking-[0.16em]">
            {item.label}
          </p>
          <p class="font-semibold text-foreground text-lg tracking-tight">
            {item.time}
          </p>
        </div>
      ))}
  </div>
</section>
