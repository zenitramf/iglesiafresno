---
import SiteContainer from "@/components/layout/site-container.astro";
import { getSpanishServiceTimes } from "@/lib/service-times";

const times = await getSpanishServiceTimes();
---

{times.length > 0 && (
    <section
      aria-label="Horarios de servicio"
      class="site-gutter border-border border-y bg-card py-8"
    >
      <SiteContainer class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {times.map((item) => (
          <div class="grid gap-1 rounded-lg border border-border/70 bg-background/40 px-4 py-4">
            <p class="font-medium text-primary-accent text-xs uppercase tracking-[0.16em]">
              {item.label}
            </p>
            <p class="font-semibold text-foreground text-lg tracking-tight">
              {item.time}
            </p>
          </div>
        ))}
      </SiteContainer>
    </section>
  )}
