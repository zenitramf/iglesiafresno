---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import SiteContainer from "@/components/layout/site-container.astro";
import ArtDirectedImage, {
  type ArtDirectedCrop,
} from "@/components/media/art-directed-image.astro";
import { Button } from "@/components/starwind/button";
import whoWeAre from "@/images/who-we-are.webp";

/**
 * The section's box changes shape with the viewport, and `object-cover` on a
 * 2.47:1 photo shows only a narrow, full-height slice of it on most screens.
 * Each band ships just that slice, pre-cropped at full height and centered,
 * so the framing matches the uncropped photo.
 *
 * A crop is only safe while it is at least as wide (relative to its height)
 * as the box; a narrower crop would make `object-cover` zoom in. The box is
 * about 38rem tall below 640px, 44rem to 1023px and 60rem above, capped near
 * 0.9 of the viewport height, so each band also checks the viewport's aspect
 * ratio. Short or very wide viewports fall through to the full photo.
 */
const WHO_WE_ARE_CROPS: ArtDirectedCrop[] = [
  // Portrait phones: 3:4 crop; the box needs ~456 CSS px of width.
  {
    height: 1632,
    media: "(max-width: 456px) and (max-aspect-ratio: 2/3)",
    sizes: "456px",
    width: 1224,
    widths: [480, 640, 800, 960],
  },
  // Large phones and tablets in portrait: 3:2 crop.
  {
    height: 1632,
    media: "(max-width: 1023px) and (max-aspect-ratio: 9/7)",
    sizes: "(max-width: 639px) 912px, 1056px",
    width: 2448,
    widths: [960, 1280, 1600],
  },
  // Laptops and desktops up to 16:10: 16:9 crop.
  {
    height: 1620,
    media: "(max-width: 1707px) and (max-aspect-ratio: 8/5)",
    sizes: "100vw",
    width: 2880,
    widths: [1280, 1600, 1920, 2560],
  },
  // Wide desktops, landscape phones: the full photo.
  {
    height: 1036,
    sizes: "100vw",
    width: 2560,
    widths: [1280, 1600, 1920, 2560],
  },
];
---

<section
  class="relative scroll-mt-24 overflow-hidden border-t border-border"
  data-who-we-are
  id="nosotros"
>
  <div class="absolute inset-0 bg-muted">
    <ArtDirectedImage
      alt="Familia de la congregación de Iglesia Bautista Victory"
      class="absolute inset-0 size-full object-cover object-top"
      crops={WHO_WE_ARE_CROPS}
      position="top"
      quality={60}
      src={whoWeAre}
    />
  </div>

  <!-- Feathered scrims — keep the church visible under the type. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-linear-to-t from-background/80 via-background/45 via-40% to-background/20"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-linear-to-r from-background/55 via-background/20 via-45% to-transparent"
  >
  </div>

  <div
    class="site-gutter relative z-10 flex min-h-[min(38rem,88svh)] flex-col justify-center py-12 sm:min-h-[min(44rem,86svh)] sm:py-16 lg:min-h-[min(60rem,90svh)]"
  >
    <SiteContainer>
      <div class="grid max-w-2xl gap-5 xl:max-w-3xl lg:gap-6">
        <div class="grid gap-4">
          <span aria-hidden="true" class="block h-0.5 w-12 bg-primary"></span>
          <h2
            class="text-balance font-semibold text-4xl text-foreground leading-tight tracking-tight drop-shadow-[0_2px_18px_rgba(0,0,0,0.55)] sm:text-5xl lg:text-6xl xl:text-7xl"
          >
            Una familia de fe arraigada en las Escrituras
          </h2>
        </div>

        <p
          class="max-w-xl text-pretty text-foreground/90 leading-relaxed drop-shadow-sm sm:text-lg"
        >
          Somos una congregación que cree en la Biblia. Nos reunimos cada
          domingo para adorar, crecer en la Palabra de Dios y servir juntos a
          nuestra ciudad.
        </p>

        <div class="pt-1">
          <Button
            class="group/btn"
            href="/nosotros/"
            size="lg"
            variant="primary"
          >
            Conoce más sobre nosotros
            <ArrowRight
              aria-hidden="true"
              class="size-4 transition-transform group-hover/btn:translate-x-1"
            />
          </Button>
        </div>
      </div>
    </SiteContainer>
  </div>
</section>
