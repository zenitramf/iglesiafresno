---
import { Button } from "@/components/starwind/button";
import { Image } from "@/components/starwind/image";
import churchFrontage from "@/images/church_frontage.webp";
---

<section
  class="scroll-mt-8 border-t border-border px-4 py-16 sm:px-6 sm:py-20 md:px-10 lg:px-14"
  id="nosotros"
>
  <div
    class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-2 lg:gap-14"
  >
    <div class="grid gap-5">
      <p
        class="text-sm font-medium tracking-[0.18em] text-primary-accent uppercase"
      >
        Quiénes somos
      </p>
      <h2
        class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl"
      >
        Una familia de fe arraigada en las Escrituras
      </h2>
      <p class="text-muted-foreground sm:text-lg">
        Iglesia Bautista Victory es una congregación que cree en la Biblia. Nos reunimos
        cada domingo para adorar, crecer en la Palabra de Dios y servir juntos a
        nuestra ciudad — ya sea que camines con Jesús desde hace décadas o aún
        estés haciendo preguntas.
      </p>
      <div>
        <Button href="/nosotros" size="md" variant="primary">
          Conoce más sobre nosotros
        </Button>
      </div>
    </div>

    <div class="relative overflow-hidden rounded-xl border border-border">
      <Image
        alt="Fachada del edificio de Iglesia Bautista Victory"
        class="aspect-4/3 size-full object-cover"
        loading="lazy"
        sizes="(max-width: 1024px) 100vw, 50vw"
        src={churchFrontage}
        widths={[640, 960, 1280]}
      />
    </div>
  </div>
</section>
