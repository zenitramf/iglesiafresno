---
import { Image as AstroImage } from "astro:assets";
import type { ComponentProps } from "astro/types";

import { image } from "./variants";

type Props = Partial<ComponentProps<typeof AstroImage>> & {
  /** Eager + high priority; page reveal waits for this image to decode. */
  critical?: boolean;
  inferSize?: boolean;
};

const {
  class: className,
  src,
  alt = "",
  inferSize = true,
  critical = false,
  priority = false,
  ...rest
} = Astro.props;

const isPriority = critical || priority;
---

{src && (
    <AstroImage
      alt={alt}
      class={image({ class: className })}
      inferSize={inferSize}
      src={src}
      {...rest}
      data-critical={critical ? "true" : undefined}
      data-slot="image"
      priority={isPriority}
    />
  )}
