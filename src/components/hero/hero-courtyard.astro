---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import { Button } from "@/components/starwind/button";
import { Image } from "@/components/starwind/image";
import CourtyardShape from "@/images/hero-courtyard-shape.svg";
import heroImage from "@/images/home-page_fvbc_hero.webp";

/**
 * SVG viewBox 2522×937 — long-X artboard for height-locked horizontal slide.
 *
 * - Top/bottom always match the hero-courtyard height (uniform scale).
 * - Width = height × (2522/937); path is never stretched or viewBox-sliced.
 * - Glass band is clamp(½, shape, ⅔) of the frame; the shape slides so its
 *   stepped right edge lands on that band (extra length runs off the left).
 * - Frame overflow + rounded-4xl masks the left bevel; left extension of the
 *   path keeps solid glass under the copy while steps stay in view.
 */
const SHAPE_VB_W = 2522;
const SHAPE_VB_H = 937;
const SHAPE_WIDTH = `calc(100cqh * ${SHAPE_VB_W} / ${SHAPE_VB_H})`;
/** Visible glass / content width: at least ½ frame, at most ⅔. */
const GLASS_BAND =
  "clamp(50%, min(var(--hero-shape-w), 66.666%), 66.666%)" as const;
---

<section
  class="bg-background px-3 py-4 text-foreground sm:px-4 lg:px-6 lg:py-6"
  id="inicio"
>
  <!--
    Desktop (xl+): full-bleed photo with a long-X SVG courtyard silhouette.
    Height-locked; slides horizontally so the stepped edge sits in the glass
    band. Mobile/tablet (< xl): title over image with scrim; CTAs below.
  -->

  <!-- Desktop: full-bleed image + SVG courtyard shape -->
  <div
    class="relative hidden h-[min(48rem,calc(75svh-3rem))] overflow-hidden rounded-4xl bg-background [container-type:size] xl:block"
    data-hero-courtyard
    style={`--hero-shape-w: ${SHAPE_WIDTH}; --hero-glass-band: ${GLASS_BAND};`}
  >
    <div
      class="absolute inset-0 overflow-hidden rounded-4xl border border-primary/40 bg-muted ring-1 ring-primary/40"
      data-hero-frame
    >
      <Image
        alt="Mural de Fresno y el horizonte de la ciudad entre la niebla"
        class="absolute inset-0 size-full object-cover object-center"
        fetchpriority="high"
        loading="eager"
        sizes="100vw"
        src={heroImage}
        widths={[960, 1440, 1920, 2560]}
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-linear-to-br from-background/40 via-background/5 to-background/20"
      ></div>
    </div>

    <!--
      Glass silhouette: height-locked, true aspect. `left` slides the long
      artboard so the stepped right edge aligns with the glass band; the long
      solid left runs under the copy (and off-frame). Path itself is not clipped
      or stretched — only the frame/courtyard rounded overflow crops the view.
    -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 z-[1] h-full text-hero-courtyard-step"
      data-hero-shape
      style={`
        width: var(--hero-shape-w);
        left: min(0px, calc(var(--hero-glass-band) - var(--hero-shape-w)));
      `}
    >
      <CourtyardShape class="size-full" preserveAspectRatio="xMinYMid meet" />
    </div>

    <!--
      Copy sits in the glass band (½–⅔ of the frame). Vertical flex keeps type
      in the middle band; horizontal padding clears the stepped right edge.
    -->
    <div
      class="relative z-[2] flex h-full min-h-0 flex-col"
      data-hero-content
      style="width: var(--hero-glass-band);"
    >
      <div aria-hidden="true" class="min-h-6 flex-1"></div>

      <div
        class="relative flex w-[85%] shrink-0 flex-col justify-center px-8 py-5 2xl:px-12 [@media(min-height:900px)]:px-10 [@media(min-height:900px)]:py-8 [@media(min-height:1000px)]:py-12"
      >
        <p
          class="font-medium text-primary-accent text-xs tracking-[0.24em] uppercase"
        >
          Iglesia Bautista Victory
        </p>

        <h1
          class="mt-3 text-balance font-heading font-light text-5xl leading-[1.1] tracking-tight [@media(min-height:900px)]:mt-4 [@media(min-height:900px)]:text-6xl [@media(min-height:900px)]:leading-none [@media(min-width:1536px)_and_(min-height:1000px)]:text-7xl [@media(min-height:1000px)]:mt-5"
        >
          Crece en la fe.<br>
          Comparte el evangelio.<br>
          Alcanza a los perdidos.
        </h1>

        <p
          class="mt-4 max-w-sm text-pretty text-muted-foreground text-sm leading-normal [@media(min-height:900px)]:mt-6 [@media(min-height:900px)]:text-base [@media(min-height:1000px)]:mt-7"
        >
          Arraigados en las Escrituras, creciendo en Cristo y llevando el
          evangelio por todo Fresno. Ven y crece con nosotros.
        </p>

        <div
          class="mt-5 flex flex-wrap items-center gap-3 [@media(min-height:900px)]:mt-7 [@media(min-height:900px)]:gap-4 [@media(min-height:1000px)]:mt-8"
        >
          <Button class="group" href="/visita" size="md" variant="primary">
            Planifica tu visita
            <ArrowRight
              aria-hidden="true"
              class="transition-transform group-hover:translate-x-1"
            />
          </Button>
          <Button class="group" href="/sermones" size="md" variant="ghost">
            Último sermón
            <ArrowRight
              aria-hidden="true"
              class="transition-transform group-hover:translate-x-1"
            />
          </Button>
        </div>
      </div>

      <div aria-hidden="true" class="min-h-6 flex-1"></div>
    </div>
  </div>

  <!-- Mobile + tablet: centered title over image, subtitle + CTAs below -->
  <div class="grid gap-9 xl:hidden">
    <div
      class="relative min-h-[min(32rem,75svh)] max-h-[75svh] overflow-hidden rounded-4xl border border-primary/40 bg-muted ring-1 ring-primary/40"
    >
      <Image
        alt="Mural de Fresno y el horizonte de la ciudad entre la niebla"
        class="absolute inset-0 size-full object-cover object-center"
        fetchpriority="high"
        loading="eager"
        sizes="100vw"
        src={heroImage}
        widths={[480, 768, 960]}
      />

      <!-- Scrim so the hero title stays readable on the photo -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-black/45"
      ></div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-black/35"
      ></div>

      <div
        class="relative z-10 flex min-h-[min(32rem,75svh)] max-h-[75svh] flex-col items-center justify-center px-6 py-10 text-center"
      >
        <p
          class="font-medium text-primary-accent text-xs tracking-[0.28em] uppercase"
        >
          Iglesia Bautista Victory
        </p>

        <h1
          class="mt-4 font-heading font-light text-[2.15rem] text-white leading-[1.1] tracking-tight drop-shadow-sm sm:text-5xl"
        >
          Crece en la fe.<br>
          Comparte el evangelio.<br>
          Alcanza a los perdidos.
        </h1>
      </div>
    </div>

    <div class="grid gap-5 px-2">
      <p
        class="text-pretty text-[0.95rem] text-muted-foreground leading-normal"
      >
        Arraigados en las Escrituras, creciendo en Cristo y llevando el
        evangelio por todo Fresno. Ven y crece con nosotros.
      </p>

      <div class="grid gap-3 pt-3">
        <Button class="group w-full" href="/visita" size="lg" variant="primary">
          Planifica tu visita
          <ArrowRight
            aria-hidden="true"
            class="transition-transform group-hover:translate-x-1"
          />
        </Button>
        <Button class="group w-full" href="/sermones" size="lg" variant="ghost">
          Último sermón
          <ArrowRight
            aria-hidden="true"
            class="transition-transform group-hover:translate-x-1"
          />
        </Button>
      </div>
    </div>
  </div>
</section>
