---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import { Button } from "@/components/starwind/button";
import { Image } from "@/components/starwind/image";
import heroImage from "@/images/home-page_fvbc_hero.webp";
---

<section class="bg-background px-3 py-4 sm:px-4 lg:px-6 lg:py-6" id="inicio">
  <!-- Desktop: full-width image card with stepped content column (xl+) -->
  <div
    class="relative hidden min-h-[min(54rem,92svh)] overflow-hidden rounded-[2.5rem] ring-1 ring-primary/60 xl:flex"
  >
    <Image
      alt="Mural de Fresno y el horizonte de la ciudad entre la niebla"
      class="absolute inset-0 size-full object-cover object-center"
      fetchpriority="high"
      loading="eager"
      sizes="100vw"
      src={heroImage}
      widths={[960, 1440, 1920, 2560]}
    />

    <!--
      Step widths scale fluidly from xl (~1280px) up to 2300px,
      then hold at their max. Mobile/tablet layout takes over below xl.
    -->
    <div
      class="relative z-10 flex min-h-[48rem] w-[clamp(30rem,calc(100vw*1280/2300),80rem)] flex-col"
    >
      <!-- Top step — overlaps into the content step so the join is continuous -->
      <div
        aria-hidden="true"
        class="pointer-events-none relative z-0 min-h-8 w-[clamp(17rem,calc(100vw*720/2300),45rem)] flex-1 -mb-6 bg-background"
      >
      </div>

      <!-- Content step -->
      <div
        class="relative z-10 flex w-full flex-col justify-center bg-background px-10 py-12 lg:px-26"
      >
        <p
          class="font-medium text-primary-accent text-xs tracking-[0.24em] uppercase"
        >
          Iglesia Fresno
        </p>

        <h1
          class="mt-5 font-light text-5xl text-foreground leading-[1.06] tracking-tight lg:text-6xl 2xl:text-7xl"
        >
          Crece en la fe.<br />
          Comparte el evangelio.<br />
          Alcanza a los perdidos.
        </h1>

        <p
          class="mt-7 max-w-sm text-pretty text-muted-foreground text-sm leading-normal lg:text-base"
        >
          Arraigados en las Escrituras, creciendo en Cristo y llevando el
          evangelio por todo Fresno. Ven y crece con nosotros.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button class="group" href="/visita" size="md" variant="primary">
            Planifica tu visita
            <ArrowRight
              aria-hidden="true"
              class="transition-transform group-hover:translate-x-1"
            />
          </Button>
          <Button class="group" href="/sermones" size="md" variant="ghost">
            Último sermón
            <ArrowRight
              aria-hidden="true"
              class="transition-transform group-hover:translate-x-1"
            />
          </Button>
        </div>

        <!-- Widest ledge at the bottom of the content step -->
        <div
          aria-hidden="true"
          class="pointer-events-none absolute right-0 bottom-0 h-[55%] w-[clamp(6.5rem,calc(100vw*80/2300),5rem)] translate-x-[calc(100%-5px)] bg-background"
        ></div>
      </div>

      <!-- Bottom step — overlaps into the content step so the join is continuous -->
      <div
        aria-hidden="true"
        class="pointer-events-none relative z-0 -mt-6 min-h-8 w-[clamp(30rem,calc(100vw*1000/2300),62.5rem)] flex-1 bg-background"
      >
      </div>
    </div>
  </div>

  <!-- Mobile + tablet: centered title over image, subtitle + CTAs below -->
  <div class="grid gap-9 xl:hidden">
    <div
      class="relative min-h-[min(32rem,78svh)] overflow-hidden rounded-[1.5rem] ring-1 ring-primary/60"
    >
      <Image
        alt="Mural de Fresno y el horizonte de la ciudad entre la niebla"
        class="absolute inset-0 size-full object-cover object-center"
        fetchpriority="high"
        loading="eager"
        sizes="100vw"
        src={heroImage}
        widths={[480, 768, 960]}
      />

      <!-- Scrim so the hero title stays readable on the photo -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-black/45"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-black/35"
      >
      </div>

      <div
        class="relative z-10 flex min-h-[min(32rem,78svh)] flex-col items-center justify-center px-6 py-10 text-center"
      >
        <p
          class="font-medium text-primary-accent text-xs tracking-[0.28em] uppercase"
        >
          Iglesia Fresno
        </p>

        <h1
          class="mt-4 font-light text-[2.15rem] text-white leading-[1.1] tracking-tight drop-shadow-sm sm:text-5xl"
        >
          Crece en la fe.<br />
          Comparte el evangelio.<br />
          Alcanza a los perdidos.
        </h1>
      </div>
    </div>

    <div class="grid gap-5 px-2">
      <p
        class="text-pretty text-[0.95rem] text-muted-foreground leading-normal"
      >
        Arraigados en las Escrituras, creciendo en Cristo y llevando el
        evangelio por todo Fresno. Ven y crece con nosotros.
      </p>

      <div class="grid gap-3 pt-3">
        <Button class="group w-full" href="/visita" size="lg" variant="primary">
          Planifica tu visita
          <ArrowRight
            aria-hidden="true"
            class="transition-transform group-hover:translate-x-1"
          />
        </Button>
        <Button class="group w-full" href="/sermones" size="lg" variant="ghost">
          Último sermón
          <ArrowRight
            aria-hidden="true"
            class="transition-transform group-hover:translate-x-1"
          />
        </Button>
      </div>
    </div>
  </div>
</section>
