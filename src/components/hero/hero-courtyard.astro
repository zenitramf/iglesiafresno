---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import { Button } from "@/components/starwind/button";
import { Image } from "@/components/starwind/image";
import heroImage from "@/images/home-page_fvbc_hero.webp";
---

<section
  class="bg-background px-3 py-4 text-foreground sm:px-4 lg:px-6 lg:py-6"
  id="inicio"
>
  <!--
    Desktop (xl+): Hero 22 courtyard cutout — bounded image with stepped
    page-background cutout, SVG fillets, fluid width clamps.

    Mobile/tablet (< xl): title over image with scrim; subtitle + CTAs below.
  -->

  <!-- Desktop: full-bleed image + stepped content column -->
  <div
    class="relative hidden h-[min(48rem,calc(75svh-3rem))] overflow-hidden bg-background xl:block"
  >
    <div
      class="absolute inset-0 overflow-hidden rounded-4xl border border-primary/40 bg-muted ring-1 ring-primary/40"
    >
      <Image
        alt="Mural de Fresno y el horizonte de la ciudad entre la niebla"
        class="absolute inset-0 size-full object-cover object-center"
        fetchpriority="high"
        loading="eager"
        sizes="100vw"
        src={heroImage}
        widths={[960, 1440, 1920, 2560]}
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-linear-to-br from-background/40 via-background/5 to-background/20"
      ></div>
    </div>

    <!--
      Step widths scale fluidly from xl (~1280px) up to 2300px,
      then hold at their max. Height is capped at 75svh so the hero
      never fills more than three-quarters of the viewport.

      Short laptop heights (e.g. 1080p @ 125% → 864svh) compress type
      and spacing so the content step fits without overflowing the cutout.
    -->
    <div
      class="relative flex h-full min-h-0 w-[clamp(30rem,calc(100vw*1280/2300),80rem)] flex-col"
    >
      <!-- Top step -->
      <div
        aria-hidden="true"
        class="pointer-events-none relative min-h-6 w-[clamp(17rem,calc(100vw*720/2300),45rem)] flex-1 rounded-t-4xl bg-hero-courtyard-step"
      >
        <svg
          aria-hidden="true"
          class="pointer-events-none absolute -right-8 bottom-0 size-8 -scale-x-100 text-hero-courtyard-step"
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M0 200A200 200 0 0 0 200 0V200H0Z"
            fill="currentColor"
          ></path>
        </svg>
      </div>

      <!-- Content step -->
      <div
        class="relative flex w-full shrink-0 flex-col justify-center rounded-tr-4xl bg-hero-courtyard-step px-8 py-5 2xl:px-12 [@media(min-height:900px)]:px-10 [@media(min-height:900px)]:py-8 [@media(min-height:1000px)]:py-12"
      >
        <p
          class="font-medium text-primary-accent text-xs tracking-[0.24em] uppercase"
        >
          Iglesia Bautista Victory
        </p>

        <h1
          class="mt-3 text-balance font-heading font-light text-5xl leading-[1.1] tracking-tight [@media(min-height:900px)]:mt-4 [@media(min-height:900px)]:text-6xl [@media(min-height:900px)]:leading-none [@media(min-width:1536px)_and_(min-height:1000px)]:text-7xl [@media(min-height:1000px)]:mt-5"
        >
          Crece en la fe.<br>
          Comparte el evangelio.<br>
          Alcanza a los perdidos.
        </h1>

        <p
          class="mt-4 max-w-sm text-pretty text-muted-foreground text-sm leading-normal [@media(min-height:900px)]:mt-6 [@media(min-height:900px)]:text-base [@media(min-height:1000px)]:mt-7"
        >
          Arraigados en las Escrituras, creciendo en Cristo y llevando el
          evangelio por todo Fresno. Ven y crece con nosotros.
        </p>

        <div
          class="mt-5 flex flex-wrap items-center gap-3 [@media(min-height:900px)]:mt-7 [@media(min-height:900px)]:gap-4 [@media(min-height:1000px)]:mt-8"
        >
          <Button class="group" href="/visita" size="md" variant="primary">
            Planifica tu visita
            <ArrowRight
              aria-hidden="true"
              class="transition-transform group-hover:translate-x-1"
            />
          </Button>
          <Button class="group" href="/sermones" size="md" variant="ghost">
            Último sermón
            <ArrowRight
              aria-hidden="true"
              class="transition-transform group-hover:translate-x-1"
            />
          </Button>
        </div>

        <!-- Right ledge at the bottom of the content step -->
        <div
          aria-hidden="true"
          class="pointer-events-none absolute right-0 bottom-0 h-[45%] w-[clamp(6.5rem,calc(100vw*80/2300),5rem)] translate-x-full rounded-r-4xl bg-hero-courtyard-step"
        ></div>
        <svg
          aria-hidden="true"
          class="pointer-events-none absolute -right-8 bottom-[45%] size-8 -scale-x-100 text-hero-courtyard-step"
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M0 200A200 200 0 0 0 200 0V200H0Z"
            fill="currentColor"
          ></path>
        </svg>
      </div>

      <!-- Bottom step -->
      <div
        aria-hidden="true"
        class="pointer-events-none relative min-h-6 w-[clamp(30rem,calc(100vw*1000/2300),62.5rem)] flex-1 rounded-b-4xl bg-hero-courtyard-step"
      >
        <svg
          aria-hidden="true"
          class="pointer-events-none absolute top-0 -right-8 size-8 rotate-180 text-hero-courtyard-step"
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M0 200A200 200 0 0 0 200 0V200H0Z"
            fill="currentColor"
          ></path>
        </svg>
      </div>
    </div>
  </div>

  <!-- Mobile + tablet: centered title over image, subtitle + CTAs below -->
  <div class="grid gap-9 xl:hidden">
    <div
      class="relative min-h-[min(32rem,75svh)] max-h-[75svh] overflow-hidden rounded-4xl border border-primary/40 bg-muted ring-1 ring-primary/40"
    >
      <Image
        alt="Mural de Fresno y el horizonte de la ciudad entre la niebla"
        class="absolute inset-0 size-full object-cover object-center"
        fetchpriority="high"
        loading="eager"
        sizes="100vw"
        src={heroImage}
        widths={[480, 768, 960]}
      />

      <!-- Scrim so the hero title stays readable on the photo -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-black/45"
      ></div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-black/35"
      ></div>

      <div
        class="relative z-10 flex min-h-[min(32rem,75svh)] max-h-[75svh] flex-col items-center justify-center px-6 py-10 text-center"
      >
        <p
          class="font-medium text-primary-accent text-xs tracking-[0.28em] uppercase"
        >
          Iglesia Bautista Victory
        </p>

        <h1
          class="mt-4 font-heading font-light text-[2.15rem] text-white leading-[1.1] tracking-tight drop-shadow-sm sm:text-5xl"
        >
          Crece en la fe.<br>
          Comparte el evangelio.<br>
          Alcanza a los perdidos.
        </h1>
      </div>
    </div>

    <div class="grid gap-5 px-2">
      <p
        class="text-pretty text-[0.95rem] text-muted-foreground leading-normal"
      >
        Arraigados en las Escrituras, creciendo en Cristo y llevando el
        evangelio por todo Fresno. Ven y crece con nosotros.
      </p>

      <div class="grid gap-3 pt-3">
        <Button class="group w-full" href="/visita" size="lg" variant="primary">
          Planifica tu visita
          <ArrowRight
            aria-hidden="true"
            class="transition-transform group-hover:translate-x-1"
          />
        </Button>
        <Button class="group w-full" href="/sermones" size="lg" variant="ghost">
          Último sermón
          <ArrowRight
            aria-hidden="true"
            class="transition-transform group-hover:translate-x-1"
          />
        </Button>
      </div>
    </div>
  </div>
</section>
