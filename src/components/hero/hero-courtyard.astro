---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import SiteContainer from "@/components/layout/site-container.astro";
import { Button } from "@/components/starwind/button";
import FresnoArchAngle from "@/images/fresno-arch-angle.svg";
import { heroCopy } from "@/lib/hero-copy";

interface Props {
  headingLevel?: "h1" | "h2";
  id?: string;
}

const { headingLevel = "h1", id = "inicio" } = Astro.props,
  Heading = headingLevel,
  headingId = `${id}-titulo`;
---

<section
  aria-labelledby={headingId}
  class="hero-gutter scroll-mt-24 bg-background py-4 text-foreground lg:py-6"
  data-hero
  data-hero-proposal="crecimiento"
  id={id}
>
  <div
    class="relative isolate min-h-[min(40rem,78svh)] overflow-hidden rounded-4xl border border-border bg-card sm:min-h-[min(44rem,78svh)]"
    data-hero-abstract="arco-fresno"
    data-hero-frame
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-linear-to-br from-background via-card to-muted"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 -right-20 size-96 rounded-full bg-primary/10 blur-3xl lg:size-[34rem]"
    >
    </div>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-[-28%] -inset-y-4 flex items-center justify-center sm:inset-x-[-12%] lg:inset-x-0"
      data-fresno-stage
    >
      <FresnoArchAngle
        class="hero-fresno-arch h-[108%] w-auto max-w-none opacity-40 sm:h-[116%] sm:opacity-45 lg:h-[112%] lg:opacity-50"
        data-fresno-arch
        data-hero-motion
        focusable="false"
      />
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 z-[1] bg-card/25"
    >
    </div>

    <SiteContainer
      class="relative z-10 flex min-h-[min(40rem,78svh)] items-center justify-center px-7 py-16 text-center sm:min-h-[min(44rem,78svh)] sm:px-10 lg:px-14"
    >
      <div
        class="grid max-w-2xl justify-items-center xl:max-w-3xl"
        data-hero-copy
      >
        <Heading
          class="text-balance font-light text-4xl leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl xl:text-7xl"
          id={headingId}
        >
          {
            heroCopy.growth.titleLines.map((line) => (
              <span class="block">{line}</span>
            ))
          }
        </Heading>
        <p
          class="mx-auto mt-6 max-w-xl text-pretty text-muted-foreground text-lg leading-relaxed sm:text-xl"
        >
          {heroCopy.welcome}
        </p>
        <div class="mt-8">
          <Button class="group" href="/visitanos/" size="lg" variant="primary">
            Planea tu visita
            <ArrowRight
              aria-hidden="true"
              class="transition-transform group-hover:translate-x-1"
            />
          </Button>
        </div>
      </div>
    </SiteContainer>
  </div>
</section>

<style>
  .hero-fresno-arch {
    animation: hero-fresno-drift 26s ease-in-out infinite alternate;
    transform-origin: 65% 55%;
  }

  @keyframes hero-fresno-drift {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-7px, -8px, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fresno-arch {
      animation: none;
    }
  }
</style>
