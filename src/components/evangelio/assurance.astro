---
import VerseCard from "@/components/evangelio/verse-card.astro";
import SiteContainer from "@/components/layout/site-container.astro";
---

<section
  class="site-gutter scroll-mt-24 border-t border-border py-16 sm:py-20"
  id="oraste-sinceramente"
>
  <SiteContainer class="grid gap-7">
    <h2 class="text-balance font-semibold text-3xl tracking-tight sm:text-4xl">
      ¿Oraste sinceramente?
    </h2>

    <p class="text-pretty text-muted-foreground text-lg leading-relaxed">
      Si oró sinceramente confiando en Cristo, la Biblia dice que usted tiene
      vida eterna.
    </p>

    <VerseCard
      citation="1 Juan 5:13"
      emphasis="monument"
      quote="Estas cosas os he escrito a vosotros que creéis en el nombre del Hijo de Dios, para que sepáis que tenéis vida eterna."
    />
  </SiteContainer>
</section>
