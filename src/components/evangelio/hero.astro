---
import ArrowDown from "@tabler/icons/outline/arrow-down.svg";
import PageHero from "@/components/layout/page-hero.astro";
---

<PageHero
  description="La Biblia responde esta pregunta con cuatro pasos claros. Tómate un momento para leerlos con calma."
  eyebrow="El mensaje de la salvación"
  id="inicio-evangelio"
  title="¿Cómo puedo ir al cielo?"
>
  <a
    class="flex flex-col items-center gap-2 font-medium text-foreground/70 text-sm tracking-wide transition-colors hover:text-primary-accent"
    href="#paso-1"
  >
    <span class="flex items-center gap-2">
      Comienza a leer
      <ArrowDown aria-hidden="true" class="size-4" />
    </span>
    <span
      class="h-10 w-px bg-linear-to-b from-primary-accent/50 to-transparent"
    ></span>
  </a>
</PageHero>
