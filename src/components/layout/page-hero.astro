---
import SiteContainer from "@/components/layout/site-container.astro";

interface Props {
  class?: string;
  description?: string;
  eyebrow: string;
  id?: string;
  title: string;
}

const { class: className, description, eyebrow, id, title } = Astro.props;
---

<section
  id={id}
  class:list={[
    "site-gutter flex min-h-[28rem] items-center pt-20 pb-16 sm:min-h-[32rem] sm:pt-28 sm:pb-20",
    className,
  ]}
>
  <SiteContainer class="flex w-full flex-col items-center gap-7 text-center">
    <p
      class="font-medium text-primary-accent text-sm tracking-[0.22em] uppercase"
    >
      {eyebrow}
    </p>

    <h1
      class="text-balance font-light text-5xl leading-tight tracking-tight sm:text-6xl 2xl:text-7xl"
    >
      {title}
    </h1>

    {description ? (
        <p class="text-pretty text-lg text-muted-foreground leading-relaxed sm:text-xl">
          {description}
        </p>
      ) : null}

    <slot />
  </SiteContainer>
</section>
