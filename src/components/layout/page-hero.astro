---
import type { ImageMetadata } from "astro";
import SiteContainer from "@/components/layout/site-container.astro";
import { Image } from "@/components/starwind/image";
import heroImage from "@/images/iglesiaFresnoHeroImage.webp";
import { HERO_IMAGE_SIZES, HERO_IMAGE_WIDTHS } from "@/lib/critical-images";

interface Props {
  class?: string;
  description?: string;
  id?: string;
  /** Background photo — defaults to the homepage courtyard image. */
  image?: ImageMetadata;
  imageAlt?: string;
  title: string;
}

const {
  class: className,
  description,
  id,
  image = heroImage,
  imageAlt = "Horizonte del centro de Fresno bajo un cielo despejado",
  title,
} = Astro.props;
---

<section
  id={id}
  class:list={[
    "hero-gutter bg-background py-4 text-foreground lg:py-6",
    className,
  ]}
>
  <!--
    Courtyard frame matching the homepage hero: near-bleed gutter and rounded
    photo well. Title stays a simple centered overlay — no glass SVG shape.
  -->
  <div
    class="relative min-h-[min(28rem,60svh)] overflow-hidden rounded-t-4xl bg-muted sm:min-h-[min(32rem,62svh)]"
  >
    <Image
      alt={imageAlt}
      class="absolute inset-0 size-full object-cover object-center"
      critical
      sizes={HERO_IMAGE_SIZES}
      src={image}
      widths={HERO_IMAGE_WIDTHS}
    />

    <!-- Scrim so hero type stays readable over the photo -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-background from-10% via-background/75 via-50% to-background/25"
    >
    </div>

    <div
      class="relative z-10 flex min-h-[min(28rem,60svh)] flex-col justify-end pt-28 pb-12 sm:min-h-[min(32rem,62svh)] sm:pt-32 sm:pb-16 lg:pb-20"
    >
      <SiteContainer
        class="flex w-full flex-col items-center gap-8 text-center"
      >
        <div class="max-w-2xl xl:max-w-3xl 2xl:max-w-4xl">
          <h1
            class="text-balance font-light text-4xl text-foreground leading-tight tracking-tight sm:text-5xl xl:text-6xl 2xl:text-7xl"
          >
            {title}
          </h1>

          {
            description ? (
              <p class="mx-auto mt-5 max-w-2xl text-pretty text-foreground/70 text-lg leading-relaxed sm:text-xl xl:max-w-3xl">
                {description}
              </p>
            ) : null
          }
        </div>

        {
          Astro.slots.has("default") ? (
            <div class="flex shrink-0 flex-col items-center gap-3">
              <slot />
            </div>
          ) : null
        }
      </SiteContainer>
    </div>
  </div>
</section>
