---
import { Button } from "@/components/starwind/button";

const navLinks = [
  { href: "/cielo", label: "Cielo" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/equipo", label: "Equipo" },
  { href: "/sermones", label: "Sermones" },
  { href: "/eventos", label: "Eventos" },
  { href: "/dar", label: "Dar" },
] as const;
---

<header class="sticky top-0 z-50" data-navbar-3>
  <nav
    aria-label="Navegación principal"
    class="@container relative inset-x-0 px-4 py-3 transition-all duration-500"
  >
    <!--
      Flex row (not absolute-centered links) so the pill never shrinks over the nav.
      On scroll: width hugs content (max-w-max), brand name hides, sticky header pins it.
    -->
    <div
      class="group/pill mx-auto flex h-14 w-full max-w-full items-center justify-between gap-3 rounded-full border border-border bg-muted/50 px-3 shadow-[inset_0_1px_0_0] shadow-muted backdrop-blur transition-[max-width,padding,gap,box-shadow] duration-500 ease-[cubic-bezier(0.33,1,0.68,1)] data-[scrolled]:max-w-max data-[scrolled]:gap-2 data-[scrolled]:px-2 data-[scrolled]:shadow-md sm:data-[scrolled]:px-3"
      data-navbar-3-pill
    >
      <div class="flex shrink-0 items-center pl-1 sm:pl-2">
        <a
          aria-label="Iglesia Fresno — inicio"
          class="flex min-w-0 items-center gap-2.5"
          href="/"
        >
          <span
            aria-hidden="true"
            class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-primary-foreground text-xs"
          >
            IF
          </span>
          <span
            aria-hidden="true"
            class="max-w-[10rem] overflow-hidden font-semibold text-sm tracking-tight whitespace-nowrap transition-all duration-500 ease-[cubic-bezier(0.33,1,0.68,1)] group-data-[scrolled]/pill:max-w-0 group-data-[scrolled]/pill:opacity-0 sm:text-base"
          >
            Iglesia Fresno
          </span>
        </a>
      </div>

      <div
        class="hidden min-w-0 shrink-0 items-center gap-0.5 @2xl:flex sm:gap-1"
      >
        {navLinks.map((link) => (
            <a
              class="rounded-md px-2.5 py-2 text-muted-foreground text-sm transition-colors hover:text-foreground sm:px-3"
              href={link.href}
            >
              {link.label}
            </a>
          ))}
      </div>

      <div class="hidden shrink-0 items-center gap-2 @2xl:flex">
        <Button class="rounded-full" href="/visita" size="sm" variant="default">
          Visítanos
        </Button>
      </div>

      <div class="shrink-0 pr-0.5 @2xl:hidden">
        <button
          aria-controls="navbar-3-menu"
          aria-expanded="false"
          aria-label="Abrir menú"
          class="group relative flex size-10 items-center justify-center"
          data-navbar-3-toggle
          type="button"
        >
          <span class="sr-only">Menú</span>
          <div aria-hidden="true" class="relative size-6">
            <span
              class="absolute top-1 left-0 h-0.5 w-full origin-center rounded-full bg-foreground transition-all duration-300 ease-out group-aria-expanded:top-1/2 group-aria-expanded:-translate-y-1/2 group-aria-expanded:rotate-45"
            ></span>
            <span
              class="absolute top-1/2 left-0 h-0.5 w-full origin-center -translate-y-1/2 rounded-full bg-foreground transition-all duration-300 ease-out group-aria-expanded:scale-x-0 group-aria-expanded:opacity-0"
            ></span>
            <span
              class="absolute bottom-1 left-0 h-0.5 w-full origin-center rounded-full bg-foreground transition-all duration-300 ease-out group-aria-expanded:bottom-1/2 group-aria-expanded:translate-y-1/2 group-aria-expanded:-rotate-45"
            ></span>
          </div>
        </button>
      </div>
    </div>

    <div
      class="absolute top-full z-40 inset-x-4 hidden pb-4 @2xl:hidden"
      data-navbar-3-menu
      id="navbar-3-menu"
    >
      <div
        class="flex max-h-[calc(100vh-5rem)] flex-col overflow-y-auto rounded-xl bg-card text-card-foreground ring-1 ring-border"
        data-slot="card"
      >
        <div class="flex flex-col p-2">
          {navLinks.map((link) => (
              <a
                class="rounded-lg px-3 py-3 text-lg text-muted-foreground transition-colors duration-300 hover:text-foreground"
                data-navbar-3-link
                href={link.href}
              >
                {link.label}
              </a>
            ))}
        </div>
        <hr class="h-px w-full shrink-0 border-0 bg-border">
        <div class="flex flex-col gap-2 p-3">
          <Button class="w-full" href="/visita" size="md" variant="default">
            Visítanos
          </Button>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const EASE = "cubic-bezier(0.33, 1, 0.68, 1)";
  const CLOSED_CLIP = "inset(0 0 100% 0 round 0.75rem)";
  const OPEN_CLIP = "inset(0 0 0% 0 round 0.75rem)";

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function animateMenu(
    element: HTMLElement,
    keyframes: Keyframe[],
    duration: number
  ) {
    for (const running of element.getAnimations()) {
      running.cancel();
    }

    if (prefersReducedMotion()) {
      const end = keyframes.at(-1);
      if (end) {
        Object.assign(element.style, end);
      }
      return Promise.resolve();
    }

    const menuAnimation = element.animate(keyframes, {
      duration,
      easing: EASE,
      fill: "forwards",
    });

    return menuAnimation.finished.then(() => {
      menuAnimation.commitStyles();
      menuAnimation.cancel();
    });
  }

  function initNavbar3() {
    const root = document.querySelector<HTMLElement>("[data-navbar-3]");
    if (!root || root.dataset.navbarReady === "true") {
      return;
    }
    root.dataset.navbarReady = "true";

    const pill = root.querySelector<HTMLElement>("[data-navbar-3-pill]");
    const toggle = root.querySelector<HTMLButtonElement>(
      "[data-navbar-3-toggle]"
    );
    const menu = root.querySelector<HTMLElement>("[data-navbar-3-menu]");
    const links = root.querySelectorAll<HTMLAnchorElement>(
      "[data-navbar-3-link]"
    );

    if (!(pill && toggle && menu)) {
      return;
    }

    let isAnimating = false;
    let isOpen = false;

    menu.style.clipPath = CLOSED_CLIP;
    menu.style.opacity = "0";
    menu.style.transform = "translateY(-8px)";

    const setExpanded = (open: boolean) => {
      isOpen = open;
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    };

    const closeMenu = async () => {
      if (isAnimating || !isOpen) {
        return;
      }

      isAnimating = true;
      setExpanded(false);

      await animateMenu(
        menu,
        [
          {
            clipPath: OPEN_CLIP,
            opacity: 1,
            transform: "translateY(0px)",
          },
          {
            clipPath: CLOSED_CLIP,
            opacity: 0,
            transform: "translateY(-8px)",
          },
        ],
        250
      );

      menu.classList.add("hidden");
      isAnimating = false;
    };

    const openMenu = async () => {
      if (isAnimating || isOpen) {
        return;
      }

      isAnimating = true;
      menu.classList.remove("hidden");
      setExpanded(true);

      // Force layout so the open animation starts from the closed state.
      menu.style.clipPath = CLOSED_CLIP;
      menu.style.opacity = "0";
      menu.style.transform = "translateY(-8px)";
      menu.getBoundingClientRect();

      await animateMenu(
        menu,
        [
          {
            clipPath: CLOSED_CLIP,
            opacity: 0,
            transform: "translateY(-8px)",
          },
          {
            clipPath: OPEN_CLIP,
            opacity: 1,
            transform: "translateY(0px)",
          },
        ],
        300
      );

      isAnimating = false;
    };

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      if (isOpen) {
        closeMenu().catch(() => undefined);
      } else {
        openMenu().catch(() => undefined);
      }
    });

    for (const link of links) {
      link.addEventListener("click", () => {
        closeMenu().catch(() => undefined);
      });
    }

    document.addEventListener("click", ({ target }) => {
      if (!(target instanceof Node) || root.contains(target)) {
        return;
      }
      closeMenu().catch(() => undefined);
    });

    document.addEventListener("keydown", ({ key }) => {
      if (key === "Escape") {
        closeMenu().catch(() => undefined);
      }
    });

    const updateScrolled = () => {
      if (window.scrollY > 10) {
        pill.setAttribute("data-scrolled", "");
      } else {
        pill.removeAttribute("data-scrolled");
      }
    };

    updateScrolled();
    window.addEventListener("scroll", updateScrolled, { passive: true });
  }

  initNavbar3();
  document.addEventListener("astro:after-swap", () => {
    const root = document.querySelector<HTMLElement>("[data-navbar-3]");
    if (root) {
      delete root.dataset.navbarReady;
    }
    initNavbar3();
  });
</script>
