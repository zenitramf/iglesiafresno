---
import { Button } from "@/components/starwind/button";

const navLinks = [
  { href: "/cielo", label: "Cielo" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/equipo", label: "Equipo" },
  { href: "/sermones", label: "Sermones" },
  { href: "/eventos", label: "Eventos" },
  { href: "/dar", label: "Dar" },
] as const;
---

<header
  class="sticky top-0 z-40 border-b border-border/60 bg-background/90 backdrop-blur-md"
>
  <nav
    aria-label="Navegación principal"
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 md:px-10 lg:px-14"
  >
    <a class="flex min-w-0 items-center gap-3" href="/">
      <span
        aria-hidden="true"
        class="flex size-10 shrink-0 items-center justify-center rounded-md bg-primary font-bold text-primary-foreground text-sm"
      >
        IF
      </span>
      <span class="grid leading-tight">
        <span
          class="font-semibold text-foreground text-sm tracking-tight sm:text-base"
        >
          Iglesia Fresno
        </span>
        <span class="hidden text-muted-foreground text-xs sm:block">
          Fresno, California
        </span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {navLinks.map((link) => (
          <li>
            <a
              class="rounded-md px-3 py-2 font-medium text-muted-foreground text-sm transition-colors hover:bg-muted hover:text-foreground"
              href={link.href}
            >
              {link.label}
            </a>
          </li>
        ))}
    </ul>

    <div class="flex items-center gap-2">
      <Button
        class="hidden sm:inline-flex"
        href="/visita"
        size="sm"
        variant="primary"
      >
        Visítanos
      </Button>

      <details class="relative lg:hidden">
        <summary
          aria-label="Abrir menú"
          class="flex size-10 list-none items-center justify-center rounded-md border border-border bg-card text-foreground marker:content-none [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">Menú</span>
          <span aria-hidden="true" class="grid gap-1.5">
            <span class="block h-0.5 w-5 bg-current"></span>
            <span class="block h-0.5 w-5 bg-current"></span>
            <span class="block h-0.5 w-5 bg-current"></span>
          </span>
        </summary>

        <div
          class="absolute top-[calc(100%+0.5rem)] right-0 z-50 w-[min(18rem,calc(100vw-2rem))] rounded-xl border border-border bg-card p-3 shadow-lg"
        >
          <ul class="grid gap-1">
            {navLinks.map((link) => (
                <li>
                  <a
                    class="block rounded-md px-3 py-2.5 font-medium text-card-foreground text-sm hover:bg-muted"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
          </ul>
          <div class="mt-2 border-t border-border pt-2">
            <Button class="w-full" href="/visita" size="sm" variant="primary">
              Visítanos
            </Button>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>
