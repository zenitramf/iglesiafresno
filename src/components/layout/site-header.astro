---
import { Button } from "@/components/starwind/button";

const navLinks = [
  { href: "/cielo", label: "Cielo" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/equipo", label: "Equipo" },
  { href: "/sermones", label: "Sermones" },
  { href: "/eventos", label: "Eventos" },
  { href: "/dar", label: "Dar" },
] as const;

const ease = "ease-[cubic-bezier(0.33,1,0.68,1)]";
---

<header class="sticky top-0 z-50" data-navbar-3>
  <nav
    aria-label="Navegación principal"
    class="@container relative inset-x-0 px-4 py-3 transition-all duration-500"
  >
    <!--
      Starwind Navbar 3 layout:
      - logo (left) + CTA (right) in normal flow with z-10
      - nav links absolutely centered so logo width changes never shift them
      - max-w-full → max-w-2xl on scroll (both lengths, so width animates)
    -->
    <div
      data-navbar-3-pill
      class:list={[
        "group/pill relative mx-auto flex h-14 w-full max-w-full items-center justify-between rounded-full border border-border bg-muted/50 pr-3 pl-1.5 shadow-[inset_0_1px_0_0] shadow-muted backdrop-blur",
        "transition-[max-width,box-shadow] duration-500",
        ease,
        "data-[scrolled]:max-w-2xl data-[scrolled]:shadow-md",
      ]}
    >
      <!-- Brand (left) — name collapses without affecting centered links -->
      <div class="relative z-10 flex shrink-0 items-center">
        <a
          aria-label="Iglesia Bautista Victory — inicio"
          href="/"
          class:list={[
            "flex items-center gap-3",
            "transition-[gap] duration-500",
            ease,
            "group-data-[scrolled]/pill:gap-0",
          ]}
        >
          <img
            alt=""
            aria-hidden="true"
            class="size-11 shrink-0 brightness-0 invert"
            height="44"
            src="/vbc_logo.svg"
            width="44"
          >
          <span
            aria-hidden="true"
            class:list={[
              "grid grid-cols-[1fr] opacity-100",
              "transition-[grid-template-columns,opacity] duration-500",
              ease,
              "group-data-[scrolled]/pill:grid-cols-[0fr] group-data-[scrolled]/pill:opacity-0",
            ]}
          >
            <span
              class="font-brand flex min-w-0 flex-col overflow-hidden leading-none uppercase whitespace-nowrap"
            >
              <span
                class="font-light text-[0.625rem] tracking-[0.2em] text-white/70"
              >
                Iglesia Bautista
              </span>
              <span class="font-medium text-xl tracking-[0.22em] text-white">
                Victory
              </span>
            </span>
          </span>
        </a>
      </div>

      <!-- Nav links — absolute center; independent of brand width -->
      <div
        class="pointer-events-none absolute inset-x-0 hidden justify-center @2xl:flex"
      >
        <div class="pointer-events-auto flex items-center gap-1">
          {navLinks.map((link) => (
              <a
                class="rounded-md px-3 py-2 text-muted-foreground text-sm transition-colors hover:text-foreground"
                href={link.href}
              >
                {link.label}
              </a>
            ))}
        </div>
      </div>

      <!-- CTA (desktop) -->
      <div class="relative z-10 hidden items-center gap-2 @2xl:flex">
        <Button
          class="rounded-full group-data-[scrolled]/pill:[padding:unset] group-data-[scrolled]/pill:px-2"
          href="visita"
          size="sm"
          variant="default"
        >
          Visítanos
        </Button>
      </div>

      <!-- Hamburger (mobile) -->
      <div class="relative z-10 pr-0.5 @2xl:hidden">
        <button
          aria-controls="navbar-3-menu"
          aria-expanded="false"
          aria-label="Abrir menú"
          class="group relative flex size-10 items-center justify-center"
          data-navbar-3-toggle
          type="button"
        >
          <span class="sr-only">Menú</span>
          <div aria-hidden="true" class="relative size-6">
            <span
              class="absolute top-1 left-0 h-0.5 w-full origin-center rounded-full bg-foreground transition-all duration-300 ease-out group-aria-expanded:top-1/2 group-aria-expanded:-translate-y-1/2 group-aria-expanded:rotate-45"
            ></span>
            <span
              class="absolute top-1/2 left-0 h-0.5 w-full origin-center -translate-y-1/2 rounded-full bg-foreground transition-all duration-300 ease-out group-aria-expanded:scale-x-0 group-aria-expanded:opacity-0"
            ></span>
            <span
              class="absolute bottom-1 left-0 h-0.5 w-full origin-center rounded-full bg-foreground transition-all duration-300 ease-out group-aria-expanded:bottom-1/2 group-aria-expanded:translate-y-1/2 group-aria-expanded:-rotate-45"
            ></span>
          </div>
        </button>
      </div>
    </div>

    <div
      class="absolute top-full z-40 inset-x-4 hidden pb-4 @2xl:hidden"
      data-navbar-3-menu
      id="navbar-3-menu"
    >
      <div
        class="flex max-h-[calc(100vh-5rem)] flex-col overflow-y-auto rounded-xl bg-card text-card-foreground ring-1 ring-border"
        data-slot="card"
      >
        <div class="flex flex-col p-2">
          {navLinks.map((link) => (
              <a
                class="rounded-lg px-3 py-3 text-lg text-muted-foreground transition-colors duration-300 hover:text-foreground"
                data-navbar-3-link
                href={link.href}
              >
                {link.label}
              </a>
            ))}
        </div>
        <hr class="h-px w-full shrink-0 border-0 bg-border">
        <div class="flex flex-col gap-2 p-3">
          <Button class="w-full" href="/visita" size="md" variant="default">
            Visítanos
          </Button>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const EASE = "cubic-bezier(0.33, 1, 0.68, 1)";
  const CLOSED_CLIP = "inset(0 0 100% 0 round 0.75rem)";
  const OPEN_CLIP = "inset(0 0 0% 0 round 0.75rem)";

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function animateMenu(
    element: HTMLElement,
    keyframes: Keyframe[],
    duration: number
  ) {
    for (const running of element.getAnimations()) {
      running.cancel();
    }

    if (prefersReducedMotion()) {
      const end = keyframes.at(-1);
      if (end) {
        Object.assign(element.style, end);
      }
      return Promise.resolve();
    }

    const menuAnimation = element.animate(keyframes, {
      duration,
      easing: EASE,
      fill: "forwards",
    });

    return menuAnimation.finished.then(() => {
      menuAnimation.commitStyles();
      menuAnimation.cancel();
    });
  }

  function initNavbar3() {
    const root = document.querySelector<HTMLElement>("[data-navbar-3]");
    if (!root || root.dataset.navbarReady === "true") {
      return;
    }
    root.dataset.navbarReady = "true";

    const pill = root.querySelector<HTMLElement>("[data-navbar-3-pill]");
    const toggle = root.querySelector<HTMLButtonElement>(
      "[data-navbar-3-toggle]"
    );
    const menu = root.querySelector<HTMLElement>("[data-navbar-3-menu]");
    const links = root.querySelectorAll<HTMLAnchorElement>(
      "[data-navbar-3-link]"
    );

    if (!(pill && toggle && menu)) {
      return;
    }

    let isAnimating = false;
    let isOpen = false;

    menu.style.clipPath = CLOSED_CLIP;
    menu.style.opacity = "0";
    menu.style.transform = "translateY(-8px)";

    const setExpanded = (open: boolean) => {
      isOpen = open;
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    };

    const closeMenu = async () => {
      if (isAnimating || !isOpen) {
        return;
      }

      isAnimating = true;
      setExpanded(false);

      await animateMenu(
        menu,
        [
          {
            clipPath: OPEN_CLIP,
            opacity: 1,
            transform: "translateY(0px)",
          },
          {
            clipPath: CLOSED_CLIP,
            opacity: 0,
            transform: "translateY(-8px)",
          },
        ],
        250
      );

      menu.classList.add("hidden");
      isAnimating = false;
    };

    const openMenu = async () => {
      if (isAnimating || isOpen) {
        return;
      }

      isAnimating = true;
      menu.classList.remove("hidden");
      setExpanded(true);

      menu.style.clipPath = CLOSED_CLIP;
      menu.style.opacity = "0";
      menu.style.transform = "translateY(-8px)";
      menu.getBoundingClientRect();

      await animateMenu(
        menu,
        [
          {
            clipPath: CLOSED_CLIP,
            opacity: 0,
            transform: "translateY(-8px)",
          },
          {
            clipPath: OPEN_CLIP,
            opacity: 1,
            transform: "translateY(0px)",
          },
        ],
        300
      );

      isAnimating = false;
    };

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      if (isOpen) {
        closeMenu().catch(() => undefined);
      } else {
        openMenu().catch(() => undefined);
      }
    });

    for (const link of links) {
      link.addEventListener("click", () => {
        closeMenu().catch(() => undefined);
      });
    }

    document.addEventListener("click", ({ target }) => {
      if (!(target instanceof Node) || root.contains(target)) {
        return;
      }
      closeMenu().catch(() => undefined);
    });

    document.addEventListener("keydown", ({ key }) => {
      if (key === "Escape") {
        closeMenu().catch(() => undefined);
      }
    });

    // Match Starwind: scroll root can be a nested overflow container or window.
    const scrollRoot =
      root.closest(".overflow-y-auto, .overflow-y-scroll") ?? window;

    const updateScrolled = () => {
      const scrollY =
        scrollRoot === window
          ? window.scrollY
          : (scrollRoot as HTMLElement).scrollTop;

      if (scrollY > 10) {
        pill.setAttribute("data-scrolled", "");
      } else {
        pill.removeAttribute("data-scrolled");
      }
    };

    updateScrolled();
    scrollRoot.addEventListener("scroll", updateScrolled, { passive: true });
  }

  initNavbar3();
  document.addEventListener("astro:after-swap", () => {
    const root = document.querySelector<HTMLElement>("[data-navbar-3]");
    if (root) {
      delete root.dataset.navbarReady;
    }
    initNavbar3();
  });
</script>
