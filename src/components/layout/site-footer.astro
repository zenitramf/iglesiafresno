---
import SiteContainer from "@/components/layout/site-container.astro";
import { churchInfo } from "@/lib/church-data";

const exploreLinks = [
  { href: "/visita", label: "Planifica tu visita" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/equipo", label: "Equipo" },
  { href: "/dar", label: "Dar" },
] as const;

const connectLinks = [
  { href: "#vision", label: "Visión" },
  { href: "/redes/facebook", label: "Facebook" },
  { href: "/redes/youtube", label: "YouTube" },
  { href: "#ofrendas", label: "Dar" },
  { href: "/portal", label: "Portal" },
] as const;

const resourceLinks = [
  { href: "/evangelio", label: "Evangelio" },
  { href: "/conferencia-misionera", label: "Conferencia misionera" },
  { href: "/privacidad", label: "Privacidad" },
  { href: "/terminos", label: "Términos de uso" },
  { href: "mailto:contacto@ejemplo.com", label: "contacto@ejemplo.com" },
] as const;
---

<footer
  class="site-gutter border-t border-border bg-card py-16 text-card-foreground"
>
  <SiteContainer>
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-4">
      <div class="flex flex-col gap-4 md:col-span-1">
        <a
          aria-label="Iglesia Bautista Victory — inicio"
          class="flex items-center gap-3"
          href="/"
        >
          <img
            alt=""
            aria-hidden="true"
            class="size-11 shrink-0 brightness-0 invert"
            height="44"
            src="/vbc_logo.svg"
            width="44"
          >
          <span
            class="font-brand flex min-w-0 flex-col overflow-hidden leading-none uppercase whitespace-nowrap"
          >
            <span
              class="font-light text-[0.625rem] tracking-[0.2em] text-white/70"
            >
              Iglesia Bautista
            </span>
            <span class="font-medium text-xl tracking-[0.22em] text-white">
              Victory
            </span>
          </span>
        </a>
        <address
          class="text-muted-foreground text-sm leading-relaxed not-italic"
        >
          <a class="transition-colors hover:text-foreground" href="/ubicacion">
            {churchInfo.addressLine1}<br>
            {churchInfo.addressLine2}
          </a>
          <br>
          <a
            class="transition-colors hover:text-foreground"
            href={`tel:${churchInfo.phoneE164}`}
          >
            {churchInfo.phone}
          </a>
        </address>
      </div>

      <div class="flex flex-col gap-3">
        <h2
          class="font-semibold text-muted-foreground text-sm tracking-widest uppercase"
        >
          Explorar
        </h2>
        <nav aria-label="Enlaces para explorar" class="flex flex-col gap-2">
          {exploreLinks.map((link) => (
              <a
                class="text-muted-foreground text-sm transition-colors hover:text-foreground"
                href={link.href}
              >
                {link.label}
              </a>
            ))}
        </nav>
      </div>

      <div class="flex flex-col gap-3">
        <h2
          class="font-semibold text-muted-foreground text-sm tracking-widest uppercase"
        >
          Conectar
        </h2>
        <nav aria-label="Enlaces para conectar" class="flex flex-col gap-2">
          {connectLinks.map((link) => (
              <a
                class="text-muted-foreground text-sm transition-colors hover:text-foreground"
                href={link.href}
              >
                {link.label}
              </a>
            ))}
        </nav>
      </div>

      <div class="flex flex-col gap-3">
        <h2
          class="font-semibold text-muted-foreground text-sm tracking-widest uppercase"
        >
          Recursos
        </h2>
        <nav aria-label="Enlaces de recursos" class="flex flex-col gap-2">
          {resourceLinks.map((link) => (
              <a
                class="text-muted-foreground text-sm transition-colors hover:text-foreground"
                href={link.href}
              >
                {link.label}
              </a>
            ))}
        </nav>
      </div>
    </div>

    <p class="text-center text-muted-foreground text-sm">
      © {new Date().getFullYear()} Iglesia Bautista Victory. Todos los derechos
      reservados.
    </p>
  </SiteContainer>
</footer>
